# ─── Notion OAuth (onboarding import) ────────────────────────────────────────
# Register a public OAuth integration at https://www.notion.so/my-integrations.
# Copy the client ID and secret, and add the redirect URI to the allowlist.
#
# For local dev: http://localhost:3000/api/notion/callback
# For prod:     https://<your-domain>/api/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback
